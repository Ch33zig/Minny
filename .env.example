# Copy to an untracked .env. No secret belongs in this file.

# Where data/logs.txt, events.parquet and the derived artifacts live.
# Set this when working from a git worktree, which does not carry gitignored
# files. Point it at the main checkout's data directory.
MINNY_DATA_DIR=

# Optional. The red team's parameter planner and the blue agent fall back to a
# seeded deterministic path when this is unset, so the whole pipeline runs
# without it. Model is pinned to claude-opus-5 in code.
ANTHROPIC_API_KEY=

# Optional, milestone M8. Every integration fails soft.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_SLACK=
COMPOSIO_AUTH_CONFIG_GITHUB=
COMPOSIO_AUTH_CONFIG_GMAIL=
