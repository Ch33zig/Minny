# Copy to an untracked .env. No secret belongs in this file.

# Where data/logs.txt, events.parquet and the derived artifacts live.
# Set this when working from a git worktree, which does not carry gitignored
# files. Point it at the main checkout's data directory.
MINNY_DATA_DIR=

# Optional. The red team's parameter planner and the blue agent fall back to a
# seeded deterministic path when this is unset, so the whole pipeline runs
# without it. Model is pinned to claude-opus-5 in code.
ANTHROPIC_API_KEY=

# Optional, milestone M8. Every integration fails soft. With none of these
# set, every capability runs on the recorded responses in
# fixtures/integrations/ and the whole demo works. Setting them turns the same
# code path into a live call.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_SLACK=
COMPOSIO_AUTH_CONFIG_GITHUB=
COMPOSIO_AUTH_CONFIG_GMAIL=

# The read only evidence scope is a separate grant from the send scope above,
# and the UI reports them as two capabilities. Falls back to
# COMPOSIO_AUTH_CONFIG_GMAIL when unset.
COMPOSIO_AUTH_CONFIG_GMAIL_READ=

# Connected account identifiers. Tokens stay at Composio; these and the
# server derived user id are all Minny keeps.
COMPOSIO_ACCOUNT_SLACK=
COMPOSIO_ACCOUNT_GMAIL=
COMPOSIO_ACCOUNT_GITHUB=
COMPOSIO_USER_ID=

# mock forces recorded responses even when keys are present, live always
# attempts the vendor and reports the failure, and the default (auto) decides
# per capability from whether its keys are there.
MINNY_INTEGRATIONS_MODE=

# Where a Slack message or a pull request body points back to. Evidence never
# leaves the app, so these links are what a notification carries instead.
MINNY_PUBLIC_BASE_URL=

# Destinations, from stored policy and never from model output.
MINNY_SLACK_CHANNEL=
MINNY_GITHUB_OWNER=
MINNY_GITHUB_REPO=
MINNY_GITHUB_BASE=

# The tracked detection gap issue, referenced as "Related to #N". Left unset,
# a pull request body references nothing rather than an invented number.
MINNY_GITHUB_GAP_ISSUE=
