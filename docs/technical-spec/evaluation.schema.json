{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evaluation_id": {
      "type": "string",
      "format": "uuid"
    },
    "experiment_id": {
      "type": "string",
      "format": "uuid"
    },
    "variant_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_set_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rule_set_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "detected",
        "evaded",
        "error"
      ]
    },
    "matched_rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "matched_synthetic_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "matched_background_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ingestion_complete": {
      "type": "boolean"
    },
    "query_complete": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "index": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "event_id",
          "index",
          "document_id"
        ]
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "evaluation_id",
    "experiment_id",
    "variant_id",
    "event_set_sha256",
    "rule_set_sha256",
    "commit_sha",
    "status",
    "matched_rule_ids",
    "matched_synthetic_event_ids",
    "matched_background_event_ids",
    "ingestion_complete",
    "query_complete",
    "evidence",
    "error"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "detected"
          }
        }
      },
      "then": {
        "properties": {
          "matched_rule_ids": {
            "minItems": 1
          },
          "matched_synthetic_event_ids": {
            "minItems": 1
          },
          "ingestion_complete": {
            "const": true
          },
          "query_complete": {
            "const": true
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "evaded"
          }
        }
      },
      "then": {
        "properties": {
          "matched_synthetic_event_ids": {
            "maxItems": 0
          },
          "ingestion_complete": {
            "const": true
          },
          "query_complete": {
            "const": true
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
